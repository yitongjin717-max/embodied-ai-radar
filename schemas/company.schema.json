{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Embodied AI Mapping company record",
  "$ref": "#/$defs/company",
  "$defs": {
    "partial_date": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^\\d{4}$"
            },
            "precision": {
              "const": "year"
            }
          },
          "required": [
            "value",
            "precision"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
            },
            "precision": {
              "const": "month"
            }
          },
          "required": [
            "value",
            "precision"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "precision": {
              "const": "day"
            }
          },
          "required": [
            "value",
            "precision"
          ]
        }
      ]
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coordinate": {
          "type": "string",
          "pattern": "^[A-Z]+[1-9][0-9]*$"
        },
        "header": {
          "type": "string",
          "minLength": 1
        },
        "raw_value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "coordinate",
        "header",
        "raw_value"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workbook": {
          "type": "string",
          "minLength": 1
        },
        "sheet": {
          "type": "string",
          "minLength": 1
        },
        "row": {
          "type": "integer",
          "minimum": 1
        },
        "cells": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/cell"
          }
        }
      },
      "required": [
        "workbook",
        "sheet",
        "row",
        "cells"
      ]
    },
    "company": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "founded_date": {
          "anyOf": [
            {
              "$ref": "#/$defs/partial_date"
            },
            {
              "type": "null"
            }
          ]
        },
        "headquarters": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "website": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "founders": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "business_description": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "primary_tracks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sub_tracks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "application_scenarios": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "technology_routes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "funding_stage": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "funding_history": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "historical_investors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "valuation": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "products": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "major_customers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "business_models": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "shipments": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "revenue": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "employee_scale": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "compiled_date": {
          "anyOf": [
            {
              "$ref": "#/$defs/partial_date"
            },
            {
              "type": "null"
            }
          ]
        },
        "latest_funding_disclosure_date": {
          "anyOf": [
            {
              "$ref": "#/$defs/partial_date"
            },
            {
              "type": "null"
            }
          ]
        },
        "interview_priority": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "investment_thesis": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "diligence_questions": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "scope_notes": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source_company_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "required": [
        "id",
        "name",
        "founded_date",
        "headquarters",
        "website",
        "founders",
        "business_description",
        "primary_tracks",
        "sub_tracks",
        "application_scenarios",
        "technology_routes",
        "funding_stage",
        "funding_history",
        "historical_investors",
        "valuation",
        "products",
        "major_customers",
        "business_models",
        "shipments",
        "revenue",
        "employee_scale",
        "compiled_date",
        "latest_funding_disclosure_date",
        "interview_priority",
        "investment_thesis",
        "diligence_questions",
        "scope_notes",
        "source_company_id",
        "provenance"
      ]
    },
    "funding_event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "company_id": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "round_name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "amount_text": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "event_date": {
          "anyOf": [
            {
              "$ref": "#/$defs/partial_date"
            },
            {
              "type": "null"
            }
          ]
        },
        "date_text": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "investor_text": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "investors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "raw_value": {
          "type": "string",
          "minLength": 1
        },
        "parse_status": {
          "enum": [
            "parsed",
            "unparsed"
          ]
        },
        "review_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "needs_review": {
          "type": "boolean"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "required": [
        "id",
        "company_id",
        "sequence",
        "round_name",
        "amount_text",
        "event_date",
        "date_text",
        "investor_text",
        "investors",
        "raw_value",
        "parse_status",
        "review_reasons",
        "needs_review",
        "provenance"
      ]
    },
    "team_member": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "company_id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "education": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "work_history": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "required": [
        "id",
        "company_id",
        "name",
        "role",
        "education",
        "work_history",
        "provenance"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "company_id": {
          "type": "string",
          "format": "uuid"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "publication_date": {
          "anyOf": [
            {
              "$ref": "#/$defs/partial_date"
            },
            {
              "type": "null"
            }
          ]
        },
        "supported_fields": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source_limits": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "retrieved_date": {
          "anyOf": [
            {
              "$ref": "#/$defs/partial_date"
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "required": [
        "id",
        "company_id",
        "url",
        "title",
        "publication_date",
        "supported_fields",
        "source_limits",
        "retrieved_date",
        "provenance"
      ]
    },
    "taxonomy_entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "field": {
          "enum": [
            "primary_tracks",
            "sub_tracks",
            "application_scenarios",
            "technology_routes",
            "business_models"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "workbooks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "field",
        "label",
        "workbooks"
      ]
    },
    "business_claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "product",
            "technology"
          ]
        },
        "status": {
          "enum": [
            "explicit",
            "inference",
            "uncertain"
          ]
        },
        "claim": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "field": {
          "enum": [
            "business_description",
            "products",
            "technology_routes"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "needs_review": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "status",
        "claim",
        "field",
        "evidence",
        "needs_review"
      ]
    },
    "funding_candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "round_name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "amount_text": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "date_text": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "investor_text": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "needs_review": {
          "const": true
        }
      },
      "required": [
        "round_name",
        "amount_text",
        "date_text",
        "investor_text",
        "evidence",
        "needs_review"
      ]
    },
    "ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {
          "enum": [
            "business_description",
            "products",
            "technology_routes",
            "funding_history",
            "funding_stage",
            "valuation",
            "scope_notes"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "needs_review": {
          "const": true
        }
      },
      "required": [
        "field",
        "evidence",
        "note",
        "needs_review"
      ]
    },
    "llm_response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "business_claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/business_claim"
          }
        },
        "funding_candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/funding_candidate"
          }
        },
        "ambiguities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ambiguity"
          }
        }
      },
      "required": [
        "business_claims",
        "funding_candidates",
        "ambiguities"
      ]
    },
    "llm_suggestion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "company_id": {
          "type": "string",
          "format": "uuid"
        },
        "provider": {
          "enum": [
            "deepseek",
            "openai"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "prompt_version": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "$ref": "#/$defs/llm_response"
        }
      },
      "required": [
        "company_id",
        "provider",
        "model",
        "prompt_version",
        "result"
      ]
    },
    "companies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/company"
      }
    },
    "funding_events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/funding_event"
      }
    },
    "team_members": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/team_member"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "taxonomy": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/taxonomy_entry"
      }
    },
    "llm_suggestions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/llm_suggestion"
      }
    }
  }
}
